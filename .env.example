# Copier en .env :  cp .env.example .env
# Le fichier .env n'est jamais versionné (voir .gitignore).

# Clé de signature des jetons de connexion (obligatoire) : openssl rand -base64 48
JWT_SECRET=remplace-moi-par-une-longue-cle-aleatoire

# Base de données
MYSQL_DATABASE=mvp_db
MYSQL_USER=gym
MYSQL_PASSWORD=change-me-db
MYSQL_ROOT_PASSWORD=change-me-root

# Origines autorisées à appeler l'API directement (séparées par des virgules)
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
